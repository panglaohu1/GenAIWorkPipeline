# 本地环境与模型（约 53 GB，不入库）
.venv/
envs/
models/
vendor/
# 运行产物、数据库、日志（运行目录约 258 MB）
runs/
data/
logs/
projects/*/runs/
muse/inbox/processed/
# 其他
__pycache__/
*.pyc
.DS_Store
.claude/
# Agent 原始学习资料库（含第三方帖子与媒体，约 170 MB），本地保存，不入库发布
agents/knowledge/*/library/
config/*.local.toml
# 本机临时同步包、实验构建物与待清理归档
_sync_mac_*
_to_delete/
build/
artifacts/
# 编辑器备份文件
*.bak
*.bak_*
*.pre_*.py
# Godot 导入缓存（可重新生成，约 28 MB）
**/.godot/
# 项目级本地备份快照（含重复大模型，约 52 MB）
projects/*/_backup_*/
# 超出 GitHub 建议体积的中间资产：大模型与重复字体副本
projects/oskar-trials/planet_game/assets/*.glb
projects/oskar-trials/planet_game/addons/pipeline/fonts/*.otf
# 本地工作区会话数据（工具记忆与状态，不入库）
.workbuddy/
