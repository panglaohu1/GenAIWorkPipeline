@@ -0,0 +1,71 @@
+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Result "downloads" from the local store: same receipts and checks, a file copy instead of HTTPS."""
+
+import hashlib
+import os
+from pathlib import Path
+from urllib.parse import urlsplit
+
+from ...jobs.transfers import (
+    DownloadedResult,
+    ResultDownloader,
+    StoragePolicy,
+    TransferError,
+    _root,
+    validate_result_name,
+)
+from . import LOCAL_STORE_HOST
+
+
+class LocalResultDownloader(ResultDownloader):
+    def __init__(self, state, *, max_bytes=512 * 1024 * 1024):
+        super().__init__(
+            StoragePolicy(frozenset({LOCAL_STORE_HOST}), max_bytes=max_bytes), online_access=lambda: True
+        )
+        self._state = state
+
+    def _source(self, url):
+        self._policy.destination(url)  # same host check as the HTTPS path
+        parts = urlsplit(url).path.strip("/").split("/")
+        if len(parts) != 3 or parts[0] != "blobs":
+            raise TransferError("Local result URL is not a stored blob")
+        try:
+            return self._state.blob_path(parts[1], parts[2])
+        except KeyError:
+            raise TransferError("Local result URL is not a stored blob") from None
+
+    def download(self, url, *, root, name, expected_size=None, expected_sha256=None, max_bytes=None,
+                 allow_size_mismatch=False, cancel=None, partial=None):
+        source = self._source(url)
+        limit = min(self._policy.max_bytes, max_bytes or self._policy.max_bytes)
+        destination = _root(root) / validate_result_name(name)
+        if destination.exists() or destination.is_symlink():
+            raise TransferError("Result filename already exists")
+        try:
+            size = source.stat().st_size
+        except OSError:
+            raise TransferError("Local result file is missing") from None
+        if size > limit:
+            raise TransferError("Storage response exceeds the byte limit")
+        if expected_size is not None and size != expected_size and not allow_size_mismatch:
+            raise TransferError("Storage response size differs from the declared result size")
+        digest = hashlib.sha256()
+        temporary = Path(str(destination) + ".partial")
+        with open(source, "rb") as reader, open(temporary, "xb") as writer:
+            while chunk := reader.read(1 << 20):
+                if cancel is not None and cancel.is_set():
+                    writer.close()
+                    temporary.unlink(missing_ok=True)
+                    raise TransferError("Storage transfer interrupted")
+                digest.update(chunk)
+                writer.write(chunk)
+            writer.flush()
+            os.fsync(writer.fileno())
+        sha = digest.hexdigest()
+        if expected_sha256 is not None and sha != expected_sha256.lower():
+            temporary.unlink(missing_ok=True)
+            raise TransferError("Storage response digest differs")
+        os.link(temporary, destination)
+        temporary.unlink()
+        return DownloadedResult(destination.name, size, sha)
