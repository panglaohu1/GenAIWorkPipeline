--- p0/scenario/core/api/local_backend/providers.py	1970-01-01 08:00:00.000000000 +0800
+++ work/scenario/core/api/local_backend/providers.py	2026-10-24 11:46:38.524710952 +0800
@@ -0,0 +1,109 @@
+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Local compute: each provider turns one job input into output files via a 127.0.0.1 service.
+
+Services belong to GenAIWorkPipeline (its console starts and unloads them). A provider never
+starts a service itself; if one is down the job fails with a message naming it.
+Endpoints can be overridden per service with GENAI_<NAME>_URL (tests use fakes instead).
+"""
+
+import json
+import os
+import urllib.error
+import urllib.request
+
+SERVICES = {
+    "image": ("GENAI_IMAGE_URL", "http://127.0.0.1:8090"),
+    "shape3d": ("GENAI_SHAPE3D_URL", "http://127.0.0.1:8098"),
+    "llm": ("GENAI_LLM_URL", "http://127.0.0.1:8081"),
+}
+LOOPBACK = ("http://127.0.0.1:", "http://localhost:")
+
+
+class ProviderError(RuntimeError):
+    """Job failure with a message safe to show (no paths outside the job)."""
+
+
+def service_url(name):
+    env, default = SERVICES[name]
+    url = os.environ.get(env) or default
+    if not url.startswith(LOOPBACK):
+        raise ProviderError(f"{name} service must be on this machine (127.0.0.1)")
+    return url.rstrip("/")
+
+
+def _post(name, path, body, timeout):
+    url = service_url(name) + path
+    request = urllib.request.Request(
+        url, data=json.dumps(body).encode(), method="POST",
+        headers={"Content-Type": "application/json"},
+    )
+    try:
+        # Loopback only; never through a proxy.
+        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+        with opener.open(request, timeout=timeout) as response:
+            return json.loads(response.read() or b"{}")
+    except urllib.error.HTTPError as error:
+        try:
+            detail = json.loads(error.read() or b"{}").get("error", "")
+        except ValueError:
+            detail = ""
+        raise ProviderError(f"{name} service error {error.code}: {detail}"[:300]) from None
+    except (urllib.error.URLError, OSError):
+        raise ProviderError(
+            f"Local {name} service is not running on {service_url(name)}; start it from the pipeline console"
+        ) from None
+
+
+def _image_size(path):
+    """(width, height) of a PNG/JPEG without third-party imports; None when unknown."""
+    try:
+        with open(path, "rb") as handle:
+            head = handle.read(32)
+            if head[:8] == b"\x89PNG\r\n\x1a\n":
+                return int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")
+            if head[:2] == b"\xff\xd8":
+                handle.seek(2)
+                while True:
+                    marker = handle.read(2)
+                    if len(marker) < 2 or marker[0] != 0xFF:
+                        return None
+                    length = int.from_bytes(handle.read(2), "big")
+                    if marker[1] in (0xC0, 0xC1, 0xC2):
+                        data = handle.read(5)
+                        return int.from_bytes(data[3:5], "big"), int.from_bytes(data[1:3], "big")
+                    handle.seek(length - 2, 1)
+    except OSError:
+        return None
+    return None
+
+
+def flux(job_input, work, resolve_input):
+    out = os.path.join(work, "image.png")
+    body = {"prompt": job_input["prompt"], "out": out, "backend": "flux"}
+    for src, dst in (("width", "width"), ("height", "height"), ("numInferenceSteps", "steps"), ("seed", "seed")):
+        if job_input.get(src) is not None:
+            body[dst] = int(job_input[src])
+    _post("image", "/generate", body, timeout=900)
+    if not os.path.isfile(out):
+        raise ProviderError("image service reported success but wrote no file")
+    size = _image_size(out) or (None, None)
+    return [{"file": out, "name": "image.png", "mimeType": "image/png",
+             "type": "inference-txt2img", "width": size[0], "height": size[1]}]
+
+
+def hunyuan3d(job_input, work, resolve_input):
+    image = resolve_input(job_input["image"])
+    out = os.path.join(work, "model.glb")
+    body = {"image": image, "out": out}
+    for src, dst in (("seed", "seed"), ("faceLimit", "max_faces"), ("octreeResolution", "octree")):
+        if job_input.get(src) is not None:
+            body[dst] = int(job_input[src])
+    result = _post("shape3d", "/generate", body, timeout=1800)
+    if not os.path.isfile(out):
+        raise ProviderError("shape3d service reported success but wrote no file")
+    return [{"file": out, "name": "model.glb", "mimeType": "model/gltf-binary",
+             "type": "img23d", "faces": result.get("faces"), "vertices": result.get("vertices")}]
+
+
+PROVIDERS = {"flux": flux, "hunyuan3d": hunyuan3d}
diff -ruN -x __pycache__ p0/scenario/core/api/local_backend/state.py work/scenario/core/api/local_backend/state.py
--- p0/scenario/core/api/local_backend/state.py	1970-01-01 08:00:00.000000000 +0800
+++ work/scenario/core/api/local_backend/state.py	2026-10-24 11:45:54.904708359 +0800
@@ -0,0 +1,106 @@
+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Durable local records (jobs, assets, uploads) and blob files under one private root.
+
+Each record is one JSON file written atomically; blobs live at blobs/<asset_id>/<name>.
+A process-wide lock serialises writes; readers always see a complete file.
+"""
+
+import datetime
+import hashlib
+import json
+import os
+import secrets
+import shutil
+import string
+import threading
+from pathlib import Path
+
+_ALPHABET = string.ascii_letters + string.digits
+_LOCK = threading.RLock()
+
+
+def new_id(prefix):
+    return prefix + "_" + "".join(secrets.choice(_ALPHABET) for _ in range(24))
+
+
+def now():
+    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
+
+
+def default_root():
+    """GENAI_SCENE_STATE overrides; otherwise ~/.genai_scene_stage (private, 0700)."""
+    root = os.environ.get("GENAI_SCENE_STATE") or os.path.join(
+        os.path.expanduser("~"), ".genai_scene_stage"
+    )
+    return Path(root)
+
+
+class LocalState:
+    KINDS = ("jobs", "assets", "uploads")
+
+    def __init__(self, root=None):
+        self.root = Path(root) if root is not None else default_root()
+        for sub in (*self.KINDS, "blobs", "work"):
+            (self.root / sub).mkdir(mode=0o700, parents=True, exist_ok=True)
+
+    # ── records ──
+    def _path(self, kind, identifier):
+        if kind not in self.KINDS or not identifier or "/" in identifier or ".." in identifier:
+            raise KeyError(identifier)
+        return self.root / kind / f"{identifier}.json"
+
+    def get(self, kind, identifier):
+        try:
+            return json.loads(self._path(kind, identifier).read_text("utf-8"))
+        except (OSError, ValueError, KeyError):
+            return None
+
+    def put(self, kind, record):
+        path = self._path(kind, record["id"])
+        data = json.dumps(record, ensure_ascii=False, indent=1).encode("utf-8")
+        with _LOCK:
+            tmp = path.with_suffix(".tmp")
+            tmp.write_bytes(data)
+            os.replace(tmp, path)
+        return record
+
+    def update(self, kind, identifier, fn):
+        with _LOCK:
+            record = self.get(kind, identifier)
+            if record is None:
+                raise KeyError(identifier)
+            fn(record)
+            record["updatedAt"] = now()
+            return self.put(kind, record)
+
+    def all(self, kind):
+        out = []
+        for path in sorted((self.root / kind).glob("*.json")):
+            try:
+                out.append(json.loads(path.read_text("utf-8")))
+            except (OSError, ValueError):
+                continue
+        return out
+
+    # ── blobs ──
+    def blob_path(self, asset_id, name):
+        if "/" in name or name.startswith(".") or "/" in asset_id or ".." in asset_id:
+            raise KeyError(name)
+        return self.root / "blobs" / asset_id / name
+
+    def add_blob(self, asset_id, source, name):
+        """Copy a provider output into the store; returns (path, size, sha256)."""
+        target = self.blob_path(asset_id, name)
+        target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        shutil.copyfile(source, target)
+        digest = hashlib.sha256()
+        with open(target, "rb") as handle:
+            while chunk := handle.read(1 << 20):
+                digest.update(chunk)
+        return target, target.stat().st_size, digest.hexdigest()
+
+    def work_dir(self, job_id):
+        path = self.root / "work" / job_id
+        path.mkdir(mode=0o700, parents=True, exist_ok=True)
+        return path
diff -ruN -x __pycache__ p0/scenario/core/api/local_backend/transport.py work/scenario/core/api/local_backend/transport.py
--- p0/scenario/core/api/local_backend/transport.py	1970-01-01 08:00:00.000000000 +0800
+++ work/scenario/core/api/local_backend/transport.py	2026-10-24 11:47:32.196714143 +0800
@@ -0,0 +1,313 @@
+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""In-process httpx transport that answers the Scenario REST surface the extension uses.
+
+Routes (all under /v1, projectId ignored):
+  GET  /teams /projects                     one local team / project
+  GET  /models  /models/{id}  POST /models/get-bulk
+  POST /generate/custom/{id}[?dryRun]       free quote / local job
+  GET  /jobs  /jobs/{id}   POST /jobs/{id}/action (cancel)
+  GET  /assets  /assets/{id}  POST /assets/get-bulk
+Anything else answers 404 with a message naming the local fork, so a missing route is
+visible instead of silently succeeding.
+"""
+
+import base64
+import json
+import mimetypes
+import threading
+import traceback
+from urllib.parse import parse_qs
+
+import httpx
+
+from . import LOCAL_STORE_HOST, catalog, providers
+from .state import LocalState, new_id, now
+
+TEAM = {"id": "team_localpipeline00000000", "name": "Local pipeline"}
+PROJECT = {"id": catalog.OWNER, "name": "Local pipeline", "teamId": TEAM["id"]}
+ACTIVE = ("pending", "queued", "in-progress")
+
+
+def _json(status, body):
+    return httpx.Response(status, json=body, headers={"Content-Type": "application/json"})
+
+
+def _not_found(what):
+    return _json(404, {"message": f"{what} is not available in the local backend", "statusCode": 404})
+
+
+def _token(offset):
+    return base64.b64encode(json.dumps({"offset": offset}).encode()).decode()
+
+
+def _offset(token):
+    if not token:
+        return 0
+    try:
+        return int(json.loads(base64.b64decode(token))["offset"])
+    except (ValueError, KeyError, TypeError):
+        return 0
+
+
+def _page(rows, query, wrapper, default_size=50):
+    size = int(query.get("pageSize", [default_size])[0] or default_size)
+    start = _offset(query.get("paginationToken", [None])[0])
+    chunk = rows[start:start + size]
+    body = {wrapper: chunk}
+    if start + size < len(rows):
+        body["nextPaginationToken"] = _token(start + size)
+    return body
+
+
+class LocalTransport(httpx.BaseTransport):
+    """One per process is enough; jobs run on daemon threads, one at a time per service."""
+
+    def __init__(self, state=None, provider_table=None):
+        self.state = state if state is not None else LocalState()
+        self.providers = provider_table if provider_table is not None else providers.PROVIDERS
+        self._gpu = threading.Lock()  # local services share one machine: run jobs serially
+        self._threads = {}
+
+    # ── httpx entry ──
+    def handle_request(self, request):
+        path = request.url.path
+        if not path.startswith("/v1/"):
+            return _not_found(path)
+        parts = path[4:].strip("/").split("/")
+        query = parse_qs(request.url.query.decode() if isinstance(request.url.query, bytes) else request.url.query)
+        body = {}
+        if request.method in ("POST", "PUT", "PATCH"):
+            raw = request.read()
+            if raw:
+                try:
+                    body = json.loads(raw)
+                except ValueError:
+                    return _json(400, {"message": "Body must be JSON"})
+        try:
+            return self._route(request.method, parts, query, body)
+        except Exception as error:  # a backend bug must surface as a 500, never hang the SDK
+            traceback.print_exc()
+            return _json(500, {"message": f"local backend error: {type(error).__name__}"})
+
+    def _route(self, method, parts, query, body):
+        head = parts[0]
+        if head == "teams" and method == "GET" and len(parts) == 1:
+            return _json(200, {"teams": [TEAM]})
+        if head == "projects" and method == "GET" and len(parts) == 1:
+            return _json(200, {"projects": [PROJECT]})
+        if head == "models":
+            return self._models(method, parts, query, body)
+        if head == "generate" and len(parts) == 3 and parts[1] == "custom" and method == "POST":
+            return self._generate(parts[2], query, body)
+        if head == "jobs":
+            return self._jobs(method, parts, query, body)
+        if head == "assets":
+            return self._assets(method, parts, query, body)
+        return _not_found("/" + "/".join(parts))
+
+    # ── models ──
+    def _models(self, method, parts, query, body):
+        if method == "GET" and len(parts) == 1:
+            rows = [catalog.public(m) for m in catalog.MODELS]
+            caps = query.get("capabilities")
+            if caps:
+                wanted = set(",".join(caps).split(","))
+                rows = [r for r in rows if wanted & set(r["capabilities"])]
+            return _json(200, _page(rows, query, "models"))
+        if method == "POST" and parts[1:] == ["get-bulk"]:
+            ids = body.get("modelIds") or []
+            return _json(200, {"models": [catalog.get(i) for i in ids if catalog.get(i)]})
+        if method == "GET" and len(parts) == 2:
+            record = catalog.get(parts[1])
+            return _json(200, {"model": record}) if record else _not_found(f"model {parts[1]}")
+        return _not_found("/models/" + "/".join(parts[1:]))
+
+    # ── generation ──
+    def _generate(self, model_id, query, body):
+        record = catalog.get(model_id)
+        if record is None:
+            return _not_found(f"model {model_id}")
+        if query.get("dryRun"):
+            # Local compute has no price; the extension still requires an exact quote.
+            return _json(200, {"creativeUnitsCost": 0, "creativeUnitsDiscount": 0, "costDetails": {}})
+        missing = [i["name"] for i in record["inputs"] if (i.get("required") or {}).get("always") and body.get(i["name"]) in (None, "")]
+        if missing:
+            return _json(400, {"message": f"Missing required input: {', '.join(missing)}"})
+        job_id = new_id("job")
+        stamp = now()
+        job = {
+            "id": job_id,
+            "jobId": job_id,
+            "jobType": "custom",
+            "billing": {"cuCost": 0, "cuDiscount": 0},
+            "metadata": {"input": {"modelId": model_id, **body}, "assetIds": []},
+            "ownerId": catalog.OWNER,
+            "authorId": catalog.AUTHOR,
+            "createdAt": stamp,
+            "updatedAt": stamp,
+            "status": "queued",
+            "statusHistory": [{"status": "pending", "date": stamp}, {"status": "queued", "date": stamp}],
+            "progress": 0,
+        }
+        self.state.put("jobs", job)
+        thread = threading.Thread(target=self._run, args=(job_id,), name=f"local-job-{job_id}", daemon=True)
+        self._threads[job_id] = thread
+        thread.start()
+        return _json(200, {"job": self._public_job(job)})
+
+    def _set_status(self, job_id, status, **fields):
+        def change(job):
+            job["status"] = status
+            job["statusHistory"].append({"status": status, "date": now()})
+            job.update(fields)
+        return self.state.update("jobs", job_id, change)
+
+    def _run(self, job_id):
+        job = self.state.get("jobs", job_id)
+        with self._gpu:
+            job = self.state.get("jobs", job_id)
+            if job is None or job["status"] == "canceled":
+                return
+            self._set_status(job_id, "in-progress", progress=0.05)
+            job_input = dict(job["metadata"]["input"])
+            model_id = job_input.pop("modelId")
+            work = str(self.state.work_dir(job_id))
+            try:
+                provider = self.providers[catalog.provider_of(model_id)]
+                outputs = provider(job_input, work, self._resolve_input)
+            except providers.ProviderError as error:
+                self._fail(job_id, str(error))
+                return
+            except Exception as error:  # provider bug: fail the job, keep the backend alive
+                traceback.print_exc()
+                self._fail(job_id, f"local provider error: {type(error).__name__}")
+                return
+            if self.state.get("jobs", job_id)["status"] == "canceled":
+                return
+            asset_ids = []
+            for out in outputs:
+                asset_ids.append(self._store_asset(out, job_id, model_id)["id"])
+
+            def done(record):
+                record["metadata"]["assetIds"] = asset_ids
+                record["progress"] = 1
+            self.state.update("jobs", job_id, done)
+            self._set_status(job_id, "success", progress=1)
+
+    def _fail(self, job_id, message):
+        def note(job):
+            job["metadata"]["error"] = message
+        self.state.update("jobs", job_id, note)
+        self._set_status(job_id, "failure", progress=0)
+
+    def _store_asset(self, out, job_id, model_id, *, kind="inference"):
+        asset_id = new_id("asset")
+        _, size, sha = self.state.add_blob(asset_id, out["file"], out["name"])
+        meta = {"type": out["type"], "kind": kind, "modelId": model_id, "jobId": job_id, "name": out["name"]}
+        for key in ("width", "height", "faces", "vertices"):
+            if out.get(key) is not None:
+                meta[key] = out[key]
+        if out.get("parentId"):
+            meta["parentId"] = out["parentId"]
+        stamp = now()
+        asset = {
+            "id": asset_id,
+            "ownerId": catalog.OWNER,
+            "authorId": catalog.AUTHOR,
+            "createdAt": stamp,
+            "updatedAt": stamp,
+            "status": "success",
+            "mimeType": out["mimeType"],
+            "url": f"https://{LOCAL_STORE_HOST}/blobs/{asset_id}/{out['name']}",
+            "properties": {"size": size, **({"width": out["width"], "height": out["height"]} if out.get("width") else {})},
+            "metadata": meta,
+            "tags": [],
+            "collectionIds": [],
+            "privacy": "private",
+            "source": "inference" if kind == "inference" else "uploaded",
+            "_sha256": sha,
+        }
+        self.state.put("assets", asset)
+        return asset
+
+    def import_file(self, path, *, asset_type="uploaded", mime=None):
+        """Register a local file as an input asset (pipeline references); returns the asset id."""
+        import os
+        name = os.path.basename(path)
+        mime = mime or mimetypes.guess_type(name)[0] or "application/octet-stream"
+        size = providers._image_size(path) if mime.startswith("image/") else None
+        out = {"file": path, "name": name, "mimeType": mime, "type": asset_type,
+               "width": size[0] if size else None, "height": size[1] if size else None}
+        return self._store_asset(out, None, None, kind="uploaded")["id"]
+
+    def _resolve_input(self, value):
+        """An input naming an asset id becomes that asset's local file path."""
+        if isinstance(value, str) and value.startswith("asset_"):
+            asset = self.state.get("assets", value)
+            if asset is None:
+                raise providers.ProviderError(f"Input asset {value} does not exist locally")
+            return str(self.state.blob_path(value, asset["metadata"]["name"]))
+        raise providers.ProviderError("Image inputs must be asset ids")
+
+    # ── jobs ──
+    @staticmethod
+    def _public_job(job):
+        return {k: v for k, v in job.items() if k != "id"}
+
+    def _jobs(self, method, parts, query, body):
+        if method == "GET" and len(parts) == 1:
+            rows = sorted(self.state.all("jobs"), key=lambda j: j["createdAt"], reverse=True)
+            status = query.get("status")
+            if status:
+                rows = [j for j in rows if j["status"] in status]
+            return _json(200, _page([self._public_job(j) for j in rows], query, "jobs"))
+        if len(parts) >= 2:
+            job = self.state.get("jobs", parts[1])
+            if job is None:
+                return _not_found(f"job {parts[1]}")
+            if method == "GET" and len(parts) == 2:
+                return _json(200, {"job": self._public_job(job)})
+            if method == "POST" and parts[2:] == ["action"]:
+                if body.get("action") != "cancel":
+                    return _json(400, {"message": "Only cancel is supported locally"})
+                if job["status"] in ACTIVE:
+                    job = self._set_status(job["id"], "canceled")
+                return _json(200, {"job": self._public_job(job)})
+        return _not_found("/jobs/" + "/".join(parts[1:]))
+
+    # ── assets ──
+    @staticmethod
+    def _public_asset(asset):
+        return {k: v for k, v in asset.items() if not k.startswith("_")}
+
+    def _assets(self, method, parts, query, body):
+        if method == "GET" and len(parts) == 1:
+            rows = sorted(self.state.all("assets"), key=lambda a: a["createdAt"], reverse=True)
+            return _json(200, _page([self._public_asset(a) for a in rows], query, "assets"))
+        if method == "POST" and parts[1:] == ["get-bulk"]:
+            ids = body.get("assetIds") or []
+            found = [self.state.get("assets", i) for i in ids]
+            return _json(200, {"assets": [self._public_asset(a) for a in found if a]})
+        if method == "GET" and len(parts) == 2:
+            asset = self.state.get("assets", parts[1])
+            return _json(200, {"asset": self._public_asset(asset)}) if asset else _not_found(f"asset {parts[1]}")
+        return _not_found("/assets/" + "/".join(parts[1:]))
+
+    def join(self, timeout=None):
+        """Tests: wait for background jobs."""
+        for thread in list(self._threads.values()):
+            thread.join(timeout)
+
+
+_SHARED = None
+_SHARED_LOCK = threading.Lock()
+
+
+def shared_transport():
+    """The process-wide backend (one job queue for this machine)."""
+    global _SHARED
+    with _SHARED_LOCK:
+        if _SHARED is None:
+            _SHARED = LocalTransport()
+        return _SHARED
