+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Local backend: the Scenario REST surface served in-process, computed by local services.
+
+The extension keeps its SDK adapter, job store, coordinator and result checks unchanged.
+Only the HTTP transport underneath is swapped: every request the SDK sends to
+LOCAL_API_URL is answered by LocalTransport from a private state directory, and work is
+done by the GenAIWorkPipeline services on 127.0.0.1 (FLUX, Hunyuan3D, Qwen ...).
+Result files are served from the same state directory by LocalResultDownloader.
+No byte leaves the machine. No bpy.
+"""
+
+LOCAL_API_URL = "https://local-api.genai.invalid/v1"
+LOCAL_STORE_HOST = "local-store.genai.invalid"
+LOCAL_KEY = "local-pipeline"
+LOCAL_SECRET = "local-pipeline"
