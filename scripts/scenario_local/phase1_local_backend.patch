+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Local model records, in the shape of GET /models/{id}, each bound to a local provider.
+
+Record shape follows the captured Scenario model records (tests/fixtures/models). Only
+inputs a provider really honours are declared, so schema validation in the extension
+rejects anything the local service would silently ignore.
+"""
+
+OWNER = "proj_localpipeline00000000"
+AUTHOR = "apiu_localpipeline00000000"
+CREATED = "2026-10-24T00:00:00.000Z"
+
+
+def _num(name, label, *, default=None, lo=None, hi=None, group="Settings"):
+    item = {"name": name, "label": label, "type": "number", "group": group, "costImpact": False}
+    if default is not None:
+        item["default"] = default
+    if lo is not None:
+        item["min"] = lo
+    if hi is not None:
+        item["max"] = hi
+    return item
+
+
+def _record(identifier, name, description, capabilities, tags, inputs, provider):
+    return {
+        "id": identifier,
+        "userId": AUTHOR,
+        "authorId": AUTHOR,
+        "ownerId": OWNER,
+        "createdAt": CREATED,
+        "updatedAt": CREATED,
+        "name": name,
+        "shortDescription": description,
+        "type": "custom",
+        "privacy": "private",
+        "capabilities": list(capabilities),
+        "source": "other",
+        "status": "trained",
+        "trainingProgress": {},
+        "parameters": {},
+        "trainingImagesNumber": 0,
+        "trainingImagePairs": [],
+        "tags": list(tags) + ["local", "sc:local-compute"],
+        "collectionIds": [],
+        "exampleAssetIds": [],
+        "custom": True,
+        "accessRestrictions": 0,
+        "complianceMetadata": {
+            "enterpriseStatus": "Ready",
+            "dataProcessingComment": "localOnly",
+            "subProcessor": "None",
+            "modelProvider": "GenAIWorkPipeline (local)",
+            "maintainer": "Local",
+        },
+        "inputs": inputs,
+        "uiConfig": {},
+        # Not part of the Scenario record; stripped before a record is served.
+        "_provider": provider,
+    }
+
+
+MODELS = [
+    _record(
+        "model_local-flux-schnell",
+        "FLUX.1 schnell (local)",
+        "Text to image on this Mac: FLUX.1 schnell 4-bit via mflux, 4 steps.",
+        ["txt2img"],
+        ["Image", "FLUX"],
+        [
+            {"name": "prompt", "label": "Prompt", "type": "string", "required": {"always": True},
+             "costImpact": False, "parent": True},
+            _num("width", "Width", default=1024, lo=256, hi=2048),
+            _num("height", "Height", default=1024, lo=256, hi=2048),
+            _num("numInferenceSteps", "Steps", default=4, lo=1, hi=8),
+            _num("seed", "Seed", lo=0, hi=2147483647),
+        ],
+        "flux",
+    ),
+    _record(
+        "model_local-hunyuan3d-2mini",
+        "Hunyuan3D-2mini Turbo (local)",
+        "Single image to untextured mesh on this Mac: Hunyuan3D-2mini Turbo, 5 steps, GLB.",
+        ["img23d"],
+        ["3d", "Image to 3D", "Hunyuan3D"],
+        [
+            {"name": "image", "label": "Image", "type": "file", "kind": "image",
+             "description": "Single image for image-to-model.", "backgroundBehavior": "transparent",
+             "required": {"always": True}, "costImpact": False, "parent": True},
+            _num("seed", "Seed", lo=0, hi=2147483647),
+            _num("faceLimit", "Face Limit", default=20000, lo=1000, hi=200000),
+            _num("octreeResolution", "Octree", default=256, lo=128, hi=512),
+        ],
+        "hunyuan3d",
+    ),
+]
+
+BY_ID = {m["id"]: m for m in MODELS}
+
+
+def public(record):
+    return {k: v for k, v in record.items() if not k.startswith("_")}
+
+
+def get(identifier):
+    record = BY_ID.get(identifier)
+    return public(record) if record is not None else None
+
+
+def provider_of(identifier):
+    record = BY_ID.get(identifier)
+    return record["_provider"] if record is not None else None
