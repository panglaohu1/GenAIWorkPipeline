@@ -0,0 +1,124 @@
+# SPDX-FileCopyrightText: 2026 GenAIWorkPipeline local modifications
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""The unchanged quote → submit → follow → download path, answered by the local backend.
+
+Providers are fakes that write small files, so this runs anywhere without GPU services.
+"""
+
+import json
+import struct
+import zlib
+from argparse import Namespace
+from decimal import Decimal
+from types import SimpleNamespace
+
+import pytest
+
+from scenario.core.api.local_backend import LOCAL_KEY, LOCAL_SECRET
+from scenario.core.api.local_backend.downloader import LocalResultDownloader
+from scenario.core.api.local_backend.providers import ProviderError
+from scenario.core.api.local_backend.state import LocalState
+from scenario.core.api.local_backend.transport import LocalTransport
+from scenario.core.api.sdk_adapter import Credentials, SDKAdapter
+from tools import smoke_image
+
+
+def png(width=8, height=6):
+    raw = b"".join(b"\x00" + b"\x80\x40\x20" * width for _ in range(height))
+
+    def chunk(kind, data):
+        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
+
+    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
+            + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
+
+
+def glb():
+    doc = json.dumps({"asset": {"version": "2.0"}, "scenes": [{"nodes": []}], "scene": 0}).encode()
+    doc += b" " * (-len(doc) % 4)
+    body = struct.pack("<I4s", len(doc), b"JSON") + doc
+    return struct.pack("<4sII", b"glTF", 2, 12 + len(body)) + body
+
+
+def fake_flux(job_input, work, resolve):
+    path = f"{work}/image.png"
+    with open(path, "wb") as handle:
+        handle.write(png(int(job_input.get("width", 8)) // 128 or 8, 6))
+    return [{"file": path, "name": "image.png", "mimeType": "image/png", "type": "inference-txt2img",
+             "width": 8, "height": 6}]
+
+
+def fake_hunyuan(job_input, work, resolve):
+    source = resolve(job_input["image"])
+    assert source.endswith(".png")
+    path = f"{work}/model.glb"
+    with open(path, "wb") as handle:
+        handle.write(glb())
+    return [{"file": path, "name": "model.glb", "mimeType": "model/gltf-binary", "type": "img23d"}]
+
+
+def broken(job_input, work, resolve):
+    raise ProviderError("Local image service is not running on http://127.0.0.1:8090")
+
+
+@pytest.fixture
+def backend(tmp_path):
+    transport = LocalTransport(LocalState(tmp_path / "state"),
+                               {"flux": fake_flux, "hunyuan3d": fake_hunyuan})
+    return transport
+
+
+def run(tmp_path, transport, model, parameters, kind):
+    settings = SimpleNamespace(credentials=SimpleNamespace(key=LOCAL_KEY, secret=LOCAL_SECRET), project_id=None)
+    params = tmp_path / f"{kind}.json"
+    params.write_text(json.dumps(parameters))
+    run_dir = tmp_path / f"run-{kind}"
+    downloader = LocalResultDownloader(transport.state)
+    quote = Namespace(command="quote", run_dir=run_dir, result_kind=kind, model=model, parameters=params,
+                      saved_runs=None, expected_result_kind=None)
+    assert smoke_image.execute(quote, settings, transport=transport, downloader=downloader) == 0
+    plan = json.loads((run_dir / "quote.json").read_text())
+    assert plan["cost"] == "0"
+    submit = Namespace(command="submit", run_dir=run_dir, approved_quote=smoke_image.digest((run_dir / "quote.json").read_bytes()),
+                       approved_cost=Decimal("0"), max_cu=Decimal("0"), timeout=30, expected_result_kind=None)
+    return smoke_image.execute(submit, settings, transport=transport, downloader=downloader), run_dir
+
+
+def test_catalog_and_quote_are_local(backend):
+    adapter = SDKAdapter(Credentials(LOCAL_KEY, LOCAL_SECRET), online=lambda: True, transport=backend)
+    try:
+        assert adapter.model("model_local-flux-schnell")["capabilities"] == ["txt2img"]
+        assert [t["id"] for t in adapter.teams()["teams"]] == ["team_localpipeline00000000"]
+    finally:
+        adapter.close()
+
+
+def test_image_job_round_trip(tmp_path, backend):
+    code, run_dir = run(tmp_path, backend, "model_local-flux-schnell", {"prompt": "a lighthouse", "width": 1024}, "image")
+    assert code == 0
+    files = list((run_dir / "results").rglob("*.png"))
+    assert len(files) == 1 and files[0].read_bytes().startswith(b"\x89PNG")
+
+
+def test_image_to_3d_uses_a_local_input_asset(tmp_path, backend):
+    ref = tmp_path / "ref.png"
+    ref.write_bytes(png())
+    asset_id = backend.import_file(str(ref))
+    code, run_dir = run(tmp_path, backend, "model_local-hunyuan3d-2mini", {"image": asset_id}, "model")
+    assert code == 0
+    assert list((run_dir / "results").rglob("*.glb"))
+
+
+def test_failed_provider_fails_the_job_with_its_message(tmp_path):
+    transport = LocalTransport(LocalState(tmp_path / "state"), {"flux": broken})
+    with pytest.raises(smoke_image.SmokeError):
+        run(tmp_path, transport, "model_local-flux-schnell", {"prompt": "x"}, "image")
+    job = transport.state.all("jobs")[0]
+    assert job["status"] == "failure" and "8090" in job["metadata"]["error"]
+
+
+def test_unknown_routes_say_local(backend):
+    import httpx
+    client = httpx.Client(transport=backend, base_url="https://local-api.genai.invalid")
+    response = client.get("/v1/workflows")
+    assert response.status_code == 404 and "local backend" in response.json()["message"]
